# ============================================================
# Lumina AI Agent System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App Settings ---
APP_NAME="Lumina AI Agent System"
DEBUG=false

# --- Server Ports ---
API_HOST=0.0.0.0
API_PORT=8000
MCP_HOST=0.0.0.0
MCP_PORT=8001

# --- Security (CHANGE THESE IN PRODUCTION!) ---
SECRET_KEY=lumina-super-secret-key-change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Mode ---
# Lumina runs fully self-contained with NO external API keys.
# All intelligence is provided by built-in knowledge bases,
# AST analysis, pattern matching, and rule-based engines.
# No GEMINI_API_KEY or any other LLM key is needed or used.

# --- Rate Limiting ---
MAX_REQUESTS_PER_MINUTE=60
MAX_CODE_EXECUTION_TIMEOUT=10
MAX_MESSAGE_LENGTH=10000

# --- Database ---
DB_PATH=data/lumina.db
